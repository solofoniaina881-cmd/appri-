{% include 'components/headpage.html.twig' %}

{% block title %}{% endblock %}

{% block body %}

    <!-- navbar -->    
    {% include 'components/navbar.html.twig' %}

    <!-- HERO -->
  <header class="hero">
    <div class="container">
      <div class="row align-items-center gy-5">
        <div class="col-lg-6 hero-content">
          <span class="eyebrow">Mille destinations, des aventures inoubliables.</span>
          <h1 class="mb-4">Explorez Madagascar, <span class="text-primary-custom">vivez </span> l'aventure !</h1>
          <p class="fs-5 mb-4" style="max-width: 540px;">
            Appri+.Trek est une plateforme dédiée à la découverte touristique de Madagascar, facilitant l'exploration, la réservation et la mise en relation des voyageurs avec les prestataires touristiques. Elle valorise le tourisme local et l'aventure.
          </p>
          <div class="d-flex flex-wrap gap-3 mb-4 justify-content-lg-start justify-content-center">
            <a href="contact.html" class="btn btn-primary btn-lg-custom">Faire un donation <i class="bi bi-arrow-right ms-1"></i></a>
            <a href="services.html" class="btn btn-light-custom btn-lg-custom">Explore Services</a>
          </div>
          <div class="d-flex align-items-center gap-3 justify-content-lg-start justify-content-center">
            <div class="d-flex">
              <img src="https://i.pravatar.cc/40?img=12" class="rounded-circle border border-2 border-white" style="width:38px;height:38px;margin-right:-10px;" alt="Client avatar">
              <img src="https://i.pravatar.cc/40?img=32" class="rounded-circle border border-2 border-white" style="width:38px;height:38px;margin-right:-10px;" alt="Client avatar">
              <img src="https://i.pravatar.cc/40?img=45" class="rounded-circle border border-2 border-white" style="width:38px;height:38px;" alt="Client avatar">
            </div>
            <div>
              <div class="stars mb-0" style="color:#FFB400; font-size:0.85rem;">★★★★★ <span class="text-navy fw-semibold">4.9/5</span></div>
              <small class="text-slate">from 320+ client reviews</small>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="hero-visual position-relative mx-auto" style="max-width: 480px;">
            <div class="hero-mock-card">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex gap-2">
                  <span style="width:10px;height:10px;border-radius:50%;background:#FF5F56;display:block;"></span>
                  <span style="width:10px;height:10px;border-radius:50%;background:#FFBD2E;display:block;"></span>
                  <span style="width:10px;height:10px;border-radius:50%;background:#27C93F;display:block;"></span>
                </div>
                <span class="badge-soft">Live</span>
              </div>
              <div class="mock-bar" style="width: 90%;"></div>
              <div class="mock-bar" style="width: 65%;"></div>
              <div class="row g-2 my-3">
                <div class="col-6">
                  <div class="p-3 rounded-3" style="background: var(--n-bg-alt);">
                    <i class="bi bi-graph-up-arrow text-primary-custom fs-4"></i>
                    <div class="fw-bold text-navy mt-2 font-display">+148%</div>
                    <small class="text-slate">Rélation Exterieur</small>
                  </div>
                </div>
                <div class="col-6">
                  <div class="p-3 rounded-3" style="background: #F4F0FF;">
                    <i class="bi bi-people text-primary-custom fs-4" style="color:var(--n-secondary) !important;"></i>
                    <div class="fw-bold text-navy mt-2 font-display">12.4k</div>
                    <small class="text-slate">Nombre de visiteur</small>
                  </div>
                </div>
              </div>
              <div class="mock-bar" style="width: 100%; height: 70px; border-radius: 10px; background: linear-gradient(90deg, var(--n-bg-alt), #F4F0FF);"></div>
            </div>
            <div class="hero-float-badge badge-1 d-none d-sm-flex">
              <div class="icon-box icon-box-success" style="width:36px;height:36px;border-radius:10px;font-size:1.1rem;"><i class="bi bi-check-lg"></i></div>
              <div>Connectez-vous <br><small class="text-slate fw-normal">à la nature, vivez l'expérience.</small></div>
            </div>
            <div class="hero-float-badge badge-2 d-none d-sm-flex">
              <div class="icon-box icon-box-primary" style="width:36px;height:36px;border-radius:10px;font-size:1.1rem;"><i class="bi bi-lightning-charge-fill"></i></div>
              <div>Appri+.Trek<br><small class="text-slate fw-normal">Des souvenirs à créer</small></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ABOUT / WHY US -->
  <section class="section">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-6 reveal">
          <div class="position-relative">
            <div id="trekCarousel" class="carousel slide carousel-fade"
                data-bs-ride="carousel" data-bs-interval="4000">

                <div class="carousel-inner rounded-4">

                    <div class="carousel-item active">
                        <img src="https://img.magnific.com/photos-premium/petit-village-dans-foret-tropicale-madagascar_620545-3689.jpg?semt=ais_hybrid&w=740&q=80"
                            class="d-block w-100"
                            style="aspect-ratio: 5/4; object-fit: cover;"
                            alt="Madagascar">
                    </div>

                    <div class="carousel-item">
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSqspvGCTxNQb2G9cyZg1VdbafyaOQyQ-NvxbWVW7LFbQ&s=10"
                            class="d-block w-100"
                            style="aspect-ratio: 5/4; object-fit: cover;"
                            alt="Paysage naturel">
                    </div>

                    <div class="carousel-item">
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTCG-tVRfqd8iBhN2slX1Kcr2Gs2SI-oaiqWkgDaHsb0g&s=10"
                            class="d-block w-100"
                            style="aspect-ratio: 5/4; object-fit: cover;"
                            alt="Trekking">
                    </div>

                </div>
            </div>
            <div class="hero-float-badge badge-2 d-none d-sm-flex" style="position:absolute; bottom:-1.5rem; left:-1.5rem; right:auto;">
              <div class="icon-box icon-box-primary" style="width:36px;height:36px;border-radius:10px;font-size:1.1rem;"><i class="bi bi-award"></i></div>
              <div>Votre partenaire d'aventure<br><small class="text-slate fw-normal">Tourisme &amp; Trekking, 2027</small></div>
            </div>
          </div>
        </div>
        <div class="col-lg-6 reveal">
          <span class="eyebrow">Pourquoi choisir Appri+.Trek ?</span>
          <h2 class="section-title">Appri+.Trek est une plateforme numérique</h2>
          <p class="section-subtitle mb-4">Facilite la découverte et la réservation de circuits touristiques à Madagascar tout en valorisant le patrimoine local.</p>
          <ul class="list-check mb-4">
            <li><i class="bi bi-check"></i><div><strong class="text-navy">Découverte</strong> — Explorez les plus beaux sites touristiques de Madagascar.</div></li>
            <li><i class="bi bi-check"></i><div><strong class="text-navy">Aventure</strong> — Vivez des expériences uniques au cœur de la nature.</div></li>
            <li><i class="bi bi-check"></i><div><strong class="text-navy">Simplicité</strong> — Organisez et réservez vos voyages facilement..</div></li>
            <li><i class="bi bi-check"></i><div><strong class="text-navy">Confiance</strong> — Retrouvez des prestataires de services touristiques..</div></li>
            <li><i class="bi bi-check"></i><div><strong class="text-navy">Souvenirs</strong> — Créez des moments inoubliables à chaque destination.</div></li>
          </ul>
          <a href="about.html" class="btn btn-primary btn-lg-custom">En savoir plus sur nous</a>
        </div>
      </div>
    </div>
  </section>
  
    <!-- PROCESS -->
  <section class="section bg-soft">
    <div class="container">
      <div class="row section-header justify-content-center text-center">
        <div class="col-lg-7 reveal">
          <span class="eyebrow">How we work</span>
          <h2 class="section-title">Madagascar, une aventure à chaque pas</h2>
          <p class="section-subtitle mx-auto">À chaque chemin, une nouvelle aventure. Explorez, découvrez, émerveillez-vous. Des paysages uniques, des aventures inoubliables</p>
        </div>
      </div>
      <div class="row g-4">
        <div class="col-md-6 col-lg-3 reveal">
          <div class="process-step">
            <span class="process-number">01</span>
            <h3 class="card-title">Aventure</h3>
            <p>Une expérience de découverte et d'exploration permettant de vivre des moments uniques, de relever des défis et de découvrir de nouveaux horizons au cœur de la nature.</p>
          </div>
        </div>
        <div class="col-md-6 col-lg-3 reveal">
          <div class="process-step">
            <span class="process-number">02</span>
            <h3 class="card-title">Explorer</h3>
            <p>Partir à la découverte de nouveaux lieux, admirer des paysages magnifiques et découvrir les richesses naturelles et culturelles de Madagascar.</p>
          </div>
        </div>
        <div class="col-md-6 col-lg-3 reveal">
          <div class="process-step">
            <span class="process-number">03</span>
            <h3 class="card-title">Souvenirs</h3>
            <p>Des moments précieux et des expériences inoubliables vécus lors de voyages, de découvertes et d'aventures au cœur de Madagascar.</p>
          </div>
        </div>
        <div class="col-md-6 col-lg-3 reveal">
          <div class="process-step">
            <span class="process-number">04</span>
            <h3 class="card-title">L'expérience</h3>
            <p>Un moment unique de découverte, de partage et d'immersion permettant de profiter pleinement des richesses naturelles, culturelles et touristiques de Madagascar.</p>
          </div>
        </div>
      </div>
    </div>
  </section>


{% include 'components/footpage.html.twig' %}
{% endblock %}
